{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development npm run build && cross-env NODE_ENV=development npm run start",
    "build": "node ./build.mjs",
    "prestart": "npm run build",
    "start": "node --env-file .env --enable-source-maps ./dist/index.mjs",
    "seed": "npm run build && node --env-file .env --enable-source-maps ./dist/seed.mjs",
    "migrate": "npm run build && node --env-file .env --enable-source-maps ./dist/migrate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@workspace/api-zod": "file:../shared/api-zod",
    "@workspace/db": "file:../shared/db",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "^0.45.2",
    "express": "^5",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.6.2",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/pg": "^8.20.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.8",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "typescript": "~5.9.2"
  }
}
